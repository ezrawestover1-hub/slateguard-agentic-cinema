{
  "name": "slateguard-demo-video",
  "version": "1.0.0",
  "description": "Captioned functional judge demo for SlateGuard.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezrawestover1-hub/slateguard-agentic-cinema.git"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/tailwind-v4": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.512",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:proof": "remotion render SlateGuardProofCut out/slateguard-proof-cut.mp4 --codec=h264 --crf=18",
    "render:judge": "remotion render SlateGuardJudgeCut out/slateguard-judge-cut-140s.mp4 --codec=h264 --crf=18",
    "render:judge-with-narration": "remotion render SlateGuardJudgeCut out/slateguard-judge-cut-with-narration.mp4 --codec=h264 --crf=18 --props='{\"narrationSrc\":\"narration.m4a\"}'"
  },
  "sideEffects": [
    "*.css"
  ]
}
