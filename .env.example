# Google Cloud / Gemini Enterprise Agent Platform
SLATEGUARD_ENV=development
SLATEGUARD_STATIC_DIR=
# Generate outside source control; required before public demo-session endpoints enable.
SLATEGUARD_DEMO_SESSION_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# Gemini 2.5 Flash and the managed Agent Runtime both use us-central1.
# Keep the model endpoint and runtime deployment aligned for the proof path.
GOOGLE_GENAI_LOCATION=us-central1
SG_AGENT_RUNTIME_LOCATION=us-central1
SG_GCP_STAGING_BUCKET=
# Non-secret Agent Runtime resource used by the backend gateway after Sprint 1.
SG_CHANGE_PACKET_RUNTIME_RESOURCE=

# ClickHouse Cloud — reader identity: curated mart views only
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=slateguard
CLICKHOUSE_READER_USER=
CLICKHOUSE_READER_PASSWORD=

# ClickHouse Cloud — writer identity: INSERT only into event tables
CLICKHOUSE_WRITER_USER=
CLICKHOUSE_WRITER_PASSWORD=

# Secure connection settings
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=30
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=90
# A bounded allowance for the first post-idle ClickHouse query; the API still
# fails closed if the official MCP path cannot return factual evidence.
CLICKHOUSE_MCP_QUERY_TIMEOUT=120

# Pinned from the official Sprint 0 MCP spike.
MCP_CLICKHOUSE_VERSION=0.4.1
